@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section class="market-panel text-center account-result-panel">
            <div class="account-result-icon" aria-hidden="true">✉</div>
            <div class="section-kicker">Account recovery</div>
            <h1 class="section-title">Check your email</h1>
            <p class="text-muted">If an eligible account matches that address, a password reset link is on its way. For your security, this page does not reveal whether an account exists.</p>
            <a asp-action="Login" class="btn btn-primary">Back to login</a>
        </section>
    </div>
</div>
