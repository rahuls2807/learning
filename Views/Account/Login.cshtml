@model WorkerBookingSystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 20px;
    }

    .login-wrapper::before {
        content: '';
        position: fixed;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 20% 50%, rgba(255, 0, 0, 0.1) 0%, transparent 50%),
                    radial-gradient(circle at 80% 80%, rgba(0, 255, 255, 0.08) 0%, transparent 50%),
                    radial-gradient(circle at 50% 50%, rgba(255, 0, 170, 0.08) 0%, transparent 70%);
        pointer-events: none;
        animation: moveGradient 20s ease infinite;
        z-index: 0;
    }

    @@keyframes moveGradient {
        0% { transform: translate(0, 0); }
        50% { transform: translate(40px, 40px); }
        100% { transform: translate(0, 0); }
    }

    .login-container {
        position: relative;
        z-index: 1;
        max-width: 450px;
        width: 100%;
        background: linear-gradient(135deg, rgba(255, 0, 0, 0.05) 0%, rgba(0, 255, 255, 0.05) 100%);
        border: 3px solid;
        border-image: linear-gradient(135deg, #ff0055 0%, #00ffcc 100%) 1;
        border-radius: 20px;
        padding: 50px 40px;
        backdrop-filter: blur(15px);
        box-shadow: 0 8px 32px rgba(255, 0, 85, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        animation: slideInUp 0.8s cubic-bezier(0.23, 1, 0.320, 1);
    }

    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .login-header h2 {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #ff0055 0%, #00ffcc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 10px;
        animation: titleGlow 3s ease-in-out infinite;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    @@keyframes titleGlow {
        0%, 100% { filter: drop-shadow(0 0 20px rgba(255, 0, 85, 0.3)); }
        50% { filter: drop-shadow(0 0 25px rgba(0, 255, 204, 0.3)); }
    }

    .login-header p {
        color: #00ffcc;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #00ffcc;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid rgba(255, 0, 85, 0.3);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font-size: 1rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #ff0055;
        background: rgba(255, 0, 85, 0.08);
        box-shadow: 0 0 15px rgba(255, 0, 85, 0.4);
    }

    .form-check {
        margin-bottom: 25px;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        border: 2px solid #ff0055;
        border-radius: 4px;
        background-color: rgba(255, 0, 85, 0.1);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .form-check-input:checked {
        background-color: #ff0055;
        border-color: #ff0055;
        box-shadow: 0 0 10px rgba(255, 0, 85, 0.5);
    }

    .form-check-label {
        color: #e0e0e0;
        margin-left: 10px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-login {
        width: 100%;
        padding: 12px 20px;
        background: linear-gradient(135deg, #ff0055 0%, #ff4477 100%);
        border: 2px solid #ff0055;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.320, 1);
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 0 20px rgba(255, 0, 85, 0.3);
    }

    .btn-login:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(255, 0, 85, 0.6);
        background: linear-gradient(135deg, #ff4477 0%, #ff0055 100%);
    }

    .btn-cancel {
        width: 100%;
        padding: 12px 20px;
        background: transparent;
        border: 2px solid #00ffcc;
        color: #00ffcc;
        font-weight: 700;
        font-size: 1rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 15px;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .btn-cancel:hover {
        background: rgba(0, 255, 204, 0.1);
        box-shadow: 0 0 15px rgba(0, 255, 204, 0.4);
        color: #ff0055;
        border-color: #ff0055;
    }

    .text-danger {
        color: #ff6b9d !important;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
    }

    .validation-summary {
        background: rgba(255, 0, 85, 0.1);
        border: 2px solid #ff0055;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 25px;
        color: #ff6b9d;
    }

    .validation-summary ul {
        margin: 0;
        padding-left: 20px;
    }

    .validation-summary li {
        margin-bottom: 5px;
    }
</style>

<div class="login-wrapper">
    <div class="login-container">
        <div class="login-header">
            <h2>🔐 LOGIN</h2>
            <p>Access your Worker Mandi account</p>
        </div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label asp-for="Email">📧 Email Address</label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">🔑 Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me on this device</label>
            </div>

            <button type="submit" class="btn-login">🚀 LOGIN</button>
            <a asp-controller="Home" asp-action="Index" class="btn-cancel">← GO BACK</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

