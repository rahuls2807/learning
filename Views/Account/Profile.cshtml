@model WorkerBookingSystem.Models.ViewModels.AccountProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="container py-4 account-profile-page">
    <div class="mb-4">
        <div class="section-kicker">ACCOUNT</div>
        <h1 class="h2 mb-1">My profile</h1>
        <p class="text-muted mb-0">Keep your contact details current for bookings and account updates.</p>
    </div>

    @if (TempData["ProfileStatus"] is string status)
    {
        <div class="alert alert-success" role="status">@status</div>
    }
    @if (TempData["ProfileWarning"] is string warning)
    {
        <div class="alert alert-warning" role="alert">@warning</div>
    }

    <form asp-action="Profile" method="post" class="account-profile-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <section class="profile-form-section">
            <h2 class="h5">Personal details</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">+91</span>
                        <input asp-for="PhoneNumber" class="form-control" type="tel" inputmode="numeric" maxlength="10" autocomplete="tel-national" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <div class="form-text">Email changes take effect after confirmation at the new address.</div>
                </div>
            </div>
        </section>

        <section class="profile-form-section">
            <h2 class="h5">Location</h2>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" autocomplete="street-address" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" autocomplete="address-level2" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="State" class="form-label"></label>
                    <input asp-for="State" class="form-control" autocomplete="address-level1" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PinCode" class="form-label"></label>
                    <input asp-for="PinCode" class="form-control" inputmode="numeric" maxlength="6" autocomplete="postal-code" />
                    <span asp-validation-for="PinCode" class="text-danger"></span>
                </div>
            </div>
        </section>

        <div class="d-flex flex-wrap gap-2 pt-3">
            <button type="submit" class="btn btn-primary">Save profile</button>
            @if (User.IsInRole("Worker"))
            {
                <a asp-controller="Worker" asp-action="Index" class="btn btn-outline-secondary">Professional profile</a>
            }
            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-secondary">Change password</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
