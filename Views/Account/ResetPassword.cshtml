@model WorkerBookingSystem.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Set a new password";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <section class="market-panel">
            <div class="text-center mb-4">
                <div class="section-kicker">Secure your account</div>
                <h1 class="section-title">Set a new password</h1>
                <p class="text-muted">Choose a new password you don't use on other sites.</p>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">New password</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Reset password</button>
            </form>
        </section>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
