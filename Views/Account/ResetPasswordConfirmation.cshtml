@{
    ViewData["Title"] = "Password reset complete";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section class="market-panel text-center account-result-panel">
            <div class="account-result-icon account-result-success" aria-hidden="true">✓</div>
            <div class="section-kicker">Password updated</div>
            <h1 class="section-title">You can sign in now</h1>
            <p class="text-muted">If your reset link was valid, your password has been changed. Sign in with the new password.</p>
            <a asp-action="Login" class="btn btn-primary">Go to login</a>
        </section>
    </div>
</div>
