@{
    ViewData["Title"] = "Reset link invalid";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <section class="market-panel text-center account-result-panel">
            <div class="account-result-icon" aria-hidden="true">!</div>
            <div class="section-kicker">Account recovery</div>
            <h1 class="section-title">That reset link can't be used</h1>
            <p class="text-muted">It may have expired or already been used. Request a new link and try again.</p>
            <a asp-action="ForgotPassword" class="btn btn-primary">Request another link</a>
            <a asp-action="Login" class="btn btn-outline-primary ms-2">Back to login</a>
        </section>
    </div>
</div>
