@model WorkerBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <section class="market-panel">
            <div class="section-kicker">Admin action</div>
            <h1 class="section-title">Create Booking</h1>
            <p class="text-muted">Assign a worker, describe the task, and record the wage amount from one clean form.</p>

            <form asp-action="CreateBooking" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="WorkerId" class="form-label">Select Worker</label>
                    <select asp-for="WorkerId" class="form-select" required>
                        <option value="">Choose a Worker</option>
                        @if (ViewBag.Workers != null)
                        {
                            @foreach (var worker in ViewBag.Workers)
                            {
                                <option value="@worker.WorkerId">@worker.FirstName @worker.LastName (@worker.Skill)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="WorkerId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TaskDescription" class="form-label">Task Description</label>
                    <textarea asp-for="TaskDescription" class="form-control" rows="4" placeholder="Describe the task to be performed..." required></textarea>
                    <span asp-validation-for="TaskDescription" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="BookingDate" class="form-label">Booking Date and Time</label>
                        <input asp-for="BookingDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="BookingDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TotalWage" class="form-label">Wage Amount (₹)</label>
                        <input asp-for="TotalWage" type="number" step="0.01" min="0" class="form-control" required />
                        <span asp-validation-for="TotalWage" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary flex-fill">Create Booking</button>
                    <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary flex-fill">Cancel</a>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
