@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    <div class="page-header">
        <div class="section-kicker">Command center</div>
        <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
            <div>
                <h1>Admin Dashboard</h1>
                <p class="text-muted mb-0">A simpler operational view for bookings, workers, rates, payments, and growth signals.</p>
            </div>
            <div class="quick-action-row">
                <a href="@Url.Action("CreateBooking")" class="btn btn-primary">Create Booking</a>
                <a href="@Url.Action("UpiPayments")" class="btn btn-secondary">UPI Payments</a>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Workers</span>
                    <span class="metric-value">@ViewBag.TotalWorkers</span>
                    <span class="text-muted">Registered profiles</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Clients</span>
                    <span class="metric-value">@ViewBag.TotalClients</span>
                    <span class="text-muted">Customer accounts</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Bookings</span>
                    <span class="metric-value">@ViewBag.TotalBookings</span>
                    <span class="text-muted">Total platform jobs</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Earnings</span>
                    <span class="metric-value">₹@ViewBag.TotalEarnings</span>
                    <span class="text-muted">Completed revenue</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Active jobs</span>
                    <span class="metric-value">@ViewBag.ActiveBookings</span>
                    <span class="text-muted">Needs monitoring</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Online collected</span>
                    <span class="metric-value">₹@ViewBag.AmountPaidOnline?.ToString("F2")</span>
                    <span class="text-muted">UPI and gateway records</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Worker paid</span>
                    <span class="metric-value">₹@ViewBag.AmountPaidToWorkers?.ToString("F2")</span>
                    <span class="text-muted">Cash paid to workers</span>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Outstanding</span>
                    <span class="metric-value">₹@ViewBag.OutstandingBalance?.ToString("F2")</span>
                    <span class="text-muted">Follow-up required</span>
                </div>
            </div>
        </div>
    </div>

    <section class="market-panel mt-4">
        <div class="section-kicker">Fast actions</div>
        <h2 class="section-title">Run the marketplace</h2>
        <div class="row g-3">
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Manage Hourly Rates</h5>
                        <p class="card-text text-muted">Set and update worker rates by skill with less navigation.</p>
                        <a href="@Url.Action("ManageRates")" class="btn btn-primary w-100">Open Rates</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Manage Bookings</h5>
                        <p class="card-text text-muted">Approve, confirm, cancel, or review bookings from one queue.</p>
                        <a href="@Url.Action("ManageBookings")" class="btn btn-primary w-100">Open Bookings</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Generate Report</h5>
                        <p class="card-text text-muted">Check earnings, jobs, and operating trends.</p>
                        <a href="@Url.Action("GenerateReport")" class="btn btn-primary w-100">Open Reports</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Manage Admins</h5>
                        <p class="card-text text-muted">Create and review admin access credentials.</p>
                        <a asp-controller="Admin" asp-action="ManageAdmins" class="btn btn-primary w-100">Open Admins</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Worker Profiles</h5>
                        <p class="card-text text-muted">Review worker details, availability, resumes, and ratings.</p>
                        <a asp-controller="Worker" asp-action="Index" class="btn btn-primary w-100">Open Workers</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Payment Review</h5>
                        <p class="card-text text-muted">Audit UPI submissions and outstanding balances quickly.</p>
                        <a href="@Url.Action("UpiPayments")" class="btn btn-primary w-100">Open Payments</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="card action-card">
                    <div class="card-body">
                        <h5 class="card-title">Profit Cut</h5>
                        <p class="card-text text-muted">Update the platform profit share and worker payout percentage.</p>
                        <a href="@Url.Action("ProfitCut")" class="btn btn-primary w-100">Manage Profit Cut</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="market-panel mt-4">
        <div class="section-kicker">Analytics</div>
        <h2 class="section-title">Platform summary</h2>
        <div class="analytics-stat">
            <span class="analytics-label">Total bookings on platform</span>
            <span class="analytics-value">@ViewBag.TotalBookings</span>
        </div>
        <div class="analytics-stat">
            <span class="analytics-label">Completed revenue</span>
            <span class="analytics-value">₹@ViewBag.TotalEarnings?.ToString("F2")</span>
        </div>
        <div class="analytics-stat">
            <span class="analytics-label">Active workers</span>
            <span class="analytics-value">@ViewBag.TotalWorkers</span>
        </div>
        @if (ViewBag.TopSkills is List<string> topSkills && topSkills.Any())
        {
            <div class="pt-3">
                <span class="analytics-label d-block mb-2">Top demanded skills</span>
                @foreach (var skill in topSkills)
                {
                    <span class="top-skills-badge">@skill</span>
                }
            </div>
        }
    </section>
</div>
