@{
    ViewData["Title"] = "My Bookings";
    var currentBookings = ViewBag.CurrentBookings as List<WorkerBookingSystem.Models.Booking>;
    var historyBookings = ViewBag.HistoryBookings as List<WorkerBookingSystem.Models.Booking>;
}

<div class="container">
    <div class="page-header">
        <div class="section-kicker">Admin bookings</div>
        <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
            <div>
                <h1>My Bookings</h1>
                <p class="text-muted mb-0">Review current and past bookings with readable status and simple actions.</p>
            </div>
            <a href="@Url.Action("CreateBooking", "Admin")" class="btn btn-primary">Create Booking</a>
        </div>
    </div>

    <div class="tabs-container">
        <button type="button" class="tab-btn active" data-tab-target="current">Current (@(currentBookings?.Count ?? 0))</button>
        <button type="button" class="tab-btn" data-tab-target="history">History (@(historyBookings?.Count ?? 0))</button>
    </div>

    <div id="current" class="tab-content">
        @if (currentBookings != null && currentBookings.Count > 0)
        {
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Worker</th>
                            <th>Task</th>
                            <th>Date and Time</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in currentBookings)
                        {
                            var statusClass = $"status-{booking.Status.ToString().ToLowerInvariant()}";
                            <tr>
                                <td>
                                    <strong>@booking.Worker?.FirstName @booking.Worker?.LastName</strong><br />
                                    <small class="text-muted">@booking.Worker?.Skill</small>
                                </td>
                                <td>@booking.TaskDescription</td>
                                <td>@booking.BookingDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>₹@booking.TotalWage.ToString("N2")</td>
                                <td><span class="status-pill @statusClass">@booking.Status</span></td>
                                <td><a href="@Url.Action("ManageBookings", "Admin")" class="btn btn-sm btn-outline-primary">Manage</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>No current bookings</h3>
                <p class="text-muted">Create a booking when a client needs help.</p>
                <a href="@Url.Action("CreateBooking", "Admin")" class="btn btn-primary">Create Booking</a>
            </div>
        }
    </div>

    <div id="history" class="tab-content" style="display:none;">
        @if (historyBookings != null && historyBookings.Count > 0)
        {
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Worker</th>
                            <th>Task</th>
                            <th>Date and Time</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in historyBookings)
                        {
                            var statusClass = $"status-{booking.Status.ToString().ToLowerInvariant()}";
                            <tr>
                                <td>
                                    <strong>@booking.Worker?.FirstName @booking.Worker?.LastName</strong><br />
                                    <small class="text-muted">@booking.Worker?.Skill</small>
                                </td>
                                <td>@booking.TaskDescription</td>
                                <td>@booking.BookingDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>₹@booking.TotalWage.ToString("N2")</td>
                                <td><span class="status-pill @statusClass">@booking.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>No booking history</h3>
                <p class="text-muted mb-0">Completed and cancelled bookings will appear here.</p>
            </div>
        }
    </div>
</div>

<script>
    document.querySelectorAll("[data-tab-target]").forEach((button) => {
        button.addEventListener("click", () => {
            document.querySelectorAll(".tab-content").forEach((tab) => tab.style.display = "none");
            document.querySelectorAll(".tab-btn").forEach((tabButton) => tabButton.classList.remove("active"));
            document.getElementById(button.dataset.tabTarget).style.display = "block";
            button.classList.add("active");
        });
    });
</script>
