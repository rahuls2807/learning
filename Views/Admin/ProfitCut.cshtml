@model decimal

@{
    ViewData["Title"] = "Profit Cut";
}

<div class="container mt-5">
    <div class="page-header mb-4">
        <h2>Platform Profit Cut</h2>
        <p class="text-muted">Set the percentage the platform retains from each booking. The worker payout is calculated from the remaining amount.</p>
    </div>

    @if (TempData["ProfitCutMessage"] != null)
    {
        <div class="alert alert-success">@TempData["ProfitCutMessage"]</div>
    }

    <form asp-action="ProfitCut" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label class="form-label" for="profitCutPercentage">Profit Cut Percentage</label>
            <input id="profitCutPercentage" name="profitCutPercentage" class="form-control" type="number" step="0.01" min="0" max="100" value="@Model" />
            <span class="text-danger">@Html.ValidationMessage("profitCutPercentage")</span>
            <div class="form-text">Enter how much percentage the platform keeps from the total booking wage.</div>
        </div>
        <div class="col-md-6 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
