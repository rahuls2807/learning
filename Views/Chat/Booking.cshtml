@model WorkerBookingSystem.Models.ViewModels.BookingChatViewModel
@{
    ViewData["Title"] = "Booking conversation";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <div class="section-kicker">Booking #@Model.BookingId · @Model.StartTime.ToString("dd MMM yyyy, h:mm tt")</div>
            <h1 class="h2">@Model.OtherParticipantName</h1>
            <p class="text-muted mb-0">@Model.TaskDescription</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-danger" asp-controller="Support" asp-action="Create" asp-route-bookingId="@Model.BookingId">Report an issue</a>
            <a class="btn btn-outline-secondary" asp-action="Index">All conversations</a>
        </div>
    </div>

    <section class="card shadow-sm" aria-label="Booking conversation">
        <div id="chatStatus" class="card-header text-muted" role="status">Connecting securely…</div>
        <div id="chatMessages" class="card-body" style="height:min(58vh,560px); overflow-y:auto" aria-live="polite"></div>
        <form id="chatForm" class="card-footer d-flex gap-2">
            @Html.AntiForgeryToken()
            <label class="visually-hidden" for="chatInput">Message</label>
            <input id="chatInput" class="form-control" maxlength="2000" autocomplete="off" placeholder="Write a message…" required />
            <button id="sendButton" class="btn btn-primary" type="submit" disabled>Send</button>
        </form>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const bookingId = @Model.BookingId;
            const currentUserId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentUserId));
            const otherParticipantName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OtherParticipantName));
            const messages = document.getElementById('chatMessages');
            const status = document.getElementById('chatStatus');
            const sendButton = document.getElementById('sendButton');
            const input = document.getElementById('chatInput');
            const renderedIds = new Set();
            let loading = false;
            let sending = false;
            let hasLoaded = false;
            let shouldScroll = true;

            function renderMessage(message) {
                const id = String(message.id);
                if (renderedIds.has(id)) return;
                renderedIds.add(id);
                const row = document.createElement('div');
                row.className = `d-flex mb-3 ${message.senderId === currentUserId ? 'justify-content-end' : 'justify-content-start'}`;
                const bubble = document.createElement('div');
                bubble.className = 'p-3 rounded-3';
                bubble.style.maxWidth = 'min(82%, 620px)';
                bubble.style.background = message.senderId === currentUserId ? '#e8f1ff' : '#f1f5f9';
                const author = document.createElement('strong');
                author.className = 'd-block small mb-1';
                author.textContent = message.senderId === currentUserId ? 'You' : (message.senderName || otherParticipantName);
                const content = document.createElement('div');
                content.style.whiteSpace = 'pre-wrap';
                content.textContent = message.content;
                const time = document.createElement('time');
                time.className = 'd-block small text-muted mt-2';
                time.dateTime = message.sentAt;
                time.textContent = new Date(message.sentAt).toLocaleString();
                bubble.append(author, content, time);
                row.appendChild(bubble);
                messages.appendChild(row);
            }

            function updateSendButton() {
                sendButton.disabled = sending || !input.value.trim();
            }

            async function loadMessages() {
                if (loading || document.visibilityState === 'hidden') return;
                loading = true;
                try {
                    const response = await fetch(`/api/message/booking/${bookingId}?page=1`, {
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) throw new Error(`Message history returned ${response.status}`);
                    const result = await response.json();
                    const wasNearBottom = messages.scrollHeight - messages.scrollTop - messages.clientHeight < 80;
                    result.messages.forEach(renderMessage);
                    if (!hasLoaded || wasNearBottom || shouldScroll) messages.scrollTop = messages.scrollHeight;
                    hasLoaded = true;
                    shouldScroll = false;
                    status.textContent = 'Connected · messages are saved to your booking';
                } catch {
                    status.textContent = hasLoaded
                        ? 'Could not refresh messages. Retrying automatically…'
                        : 'Messages are temporarily unavailable. You can still try sending; we will keep retrying.';
                } finally {
                    loading = false;
                }
            }

            input.addEventListener('input', updateSendButton);
            updateSendButton();

            document.getElementById('chatForm').addEventListener('submit', async event => {
                event.preventDefault();
                const content = input.value.trim();
                if (!content || sending) return;
                sending = true;
                updateSendButton();
                try {
                    const response = await fetch('/api/message/send', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ bookingId, content })
                    });
                    if (!response.ok) throw new Error(`Message send returned ${response.status}`);
                    const result = await response.json();
                    input.value = '';
                    input.focus();
                    shouldScroll = true;
                    await loadMessages();
                    if (!renderedIds.has(String(result.messageId))) {
                        renderMessage({
                            id: result.messageId,
                            senderId: currentUserId,
                            senderName: 'You',
                            content,
                            sentAt: result.sentAt
                        });
                        messages.scrollTop = messages.scrollHeight;
                    }
                    status.textContent = 'Message sent · conversation is saved to your booking';
                } catch {
                    status.textContent = 'Message was not sent. Check your connection and try again.';
                } finally {
                    sending = false;
                    updateSendButton();
                }
            });

            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') loadMessages();
            });
            loadMessages();
            window.setInterval(loadMessages, 5000);
        })();
    </script>
}
