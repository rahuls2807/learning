@model IEnumerable<WorkerBookingSystem.Models.ViewModels.ChatConversationViewModel>
@{
    ViewData["Title"] = "Booking messages";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <div class="section-kicker">Direct communication</div>
            <h1>Booking messages</h1>
            <p class="text-muted">Private conversations are available only to the client and worker on each booking.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Support" asp-action="Index">Get support</a>
        <a class="btn btn-outline-primary" asp-controller="CommunityChat" asp-action="Index">Community messages</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h3>No booking conversations yet</h3>
            <p class="text-muted">A conversation becomes available when you have a booking.</p>
            @if (User.IsInRole("Worker"))
            {
                <a class="btn btn-primary" asp-controller="Worker" asp-action="MyBookings">View jobs</a>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Client" asp-action="MyBookings">View bookings</a>
            }
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var conversation in Model)
            {
                <div class="col-lg-6">
                    <article class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2">
                                <h2 class="h5">@conversation.OtherParticipantName</h2>
                                <span class="status-pill status-@conversation.Status.ToString().ToLowerInvariant()">@conversation.Status</span>
                            </div>
                            <p class="text-muted mb-1">Booking #@conversation.BookingId · @conversation.BookingDate.ToString("dd MMM yyyy")</p>
                            <p class="flex-grow-1">@conversation.TaskDescription</p>
                            <a class="btn btn-primary" asp-action="Booking" asp-route-bookingId="@conversation.BookingId">Open conversation</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
