@model WorkerBookingSystem.Models.ViewModels.PagedResult<WorkerBookingSystem.Models.ViewModels.WorkerSearchItemViewModel>

@{
    ViewData["Title"] = "Book a Worker";
}

<div class="container">
    <div class="page-header">
        <div class="section-kicker">Book trusted help</div>
        <h2>Find a Worker</h2>
        <p class="text-muted">Search by skill, compare ratings, and book from a cleaner mobile-friendly marketplace.</p>
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="search">Search</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Try electrician, plumber, cleaner..." />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="skill">Skill</label>
                <select id="skill" name="skill" class="form-select">
                    <option value="">All skills</option>
                    @foreach (var skill in (IEnumerable<string>)ViewBag.Skills)
                    {
                        <option value="@skill" selected="@(skill == Model.Skill)">@skill</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Search Workers</button>
            </div>
        </form>
        <div class="filter-chip-row mt-3">
            <span class="filter-chip">Top rated first</span>
            <span class="filter-chip">Transparent rates</span>
            <span class="filter-chip">Profile before booking</span>
            <span class="filter-chip">Mobile booking ready</span>
        </div>
        <p class="text-muted mt-3 mb-0">@Model.TotalItems workers found. Showing page @Model.Page of @Model.TotalPages.</p>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row g-3">
            @foreach (var worker in Model.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card worker-card h-100">
                        @if (!string.IsNullOrWhiteSpace(worker.ProfileImagePath))
                        {
                            <img src="@worker.ProfileImagePath" class="card-img-top worker-card-image" alt="@worker.Name" />
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-2 align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">@worker.Name</h5>
                                    <div class="text-muted">@worker.Skill</div>
                                </div>
                                <span class="status-pill">@(worker.IsActive ? "Active" : "Inactive")</span>
                            </div>
                            <div class="rating-line mt-3">
                                @(worker.AverageRating.HasValue ? $"{worker.AverageRating.Value:F1}/5 rating" : "New profile")
                                <span class="text-muted">(@worker.ReviewCount reviews)</span>
                            </div>
                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">Rate</small>
                                    <strong>@(worker.DisplayRate.HasValue && worker.DisplayRate.Value > 0 ? $"₹{worker.DisplayRate.Value:F2}/hr" : "Pending")</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Completed</small>
                                    <strong>@worker.CompletedJobs jobs</strong>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <a asp-action="CreateBooking" asp-route-workerId="@worker.WorkerId" class="btn btn-primary flex-fill">Book Now</a>
                                <a asp-controller="Worker" asp-action="Details" asp-route-id="@worker.WorkerId" class="btn btn-outline-primary flex-fill">Profile</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No workers available at the moment.</div>
    }

    <nav aria-label="Worker search pages">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="BookWorker" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-skill="@Model.Skill">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="BookWorker" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-skill="@Model.Skill">Next</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Back to Home</a>
    </div>
</div>
