@model WorkerBookingSystem.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
    var worker = (WorkerBookingSystem.Models.Worker)ViewBag.Worker;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2>Book @worker.FirstName @worker.LastName</h2>
            <p class="text-muted">Skill: @worker.Skill</p>
            <div class="alert alert-secondary p-3">
                <div><strong>Hourly rate:</strong> @if (ViewBag.WorkerRate != null) { <span>₹@((decimal)ViewBag.WorkerRate).ToString("F2") / hr</span> } else { <span class="text-muted">Not configured yet</span> }</div>
                <div><strong>Estimated total:</strong> <span id="bookingTotalAmount">₹0.00</span></div>
                <div><small id="bookingDuration" class="text-muted"></small></div>
            </div>

            <form asp-action="CreateBooking" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="WorkerId" value="@worker.WorkerId" />
                @if (ViewBag.CurrentClientId != null)
                {
                    <input type="hidden" asp-for="ClientId" value="@ViewBag.CurrentClientId" />
                }
                else
                {
                    <div class="form-group">
                        <label asp-for="ClientId" class="control-label">Client</label>
                        <select asp-for="ClientId" class="form-select">
                            <option value="">Select a client</option>
                            @foreach (var client in (IEnumerable<WorkerBookingSystem.Models.Client>)ViewBag.ClientList)
                            {
                                <option value="@client.ClientId">@client.FirstName @client.LastName</option>
                            }
                        </select>
                        <span asp-validation-for="ClientId" class="text-danger"></span>
                    </div>
                }

                <div class="form-group">
                    <label asp-for="BookingDate" class="control-label">Booking Date</label>
                    <input asp-for="BookingDate" class="form-control" type="date" />
                    <span asp-validation-for="BookingDate" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="StartTime" class="control-label">Start Time</label>
                            <input asp-for="StartTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EndTime" class="control-label">End Time</label>
                            <input asp-for="EndTime" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TaskDescription" class="control-label">Task Description</label>
                    <textarea asp-for="TaskDescription" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="TaskDescription" class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    <strong>Note:</strong> Total wage will be calculated automatically based on hourly rate set in admin panel.
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-success">Confirm Booking</button>
                    <a href="@Url.Action("BookWorker")" class="btn btn-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var startInput = document.querySelector('input[name="StartTime"]');
            var endInput = document.querySelector('input[name="EndTime"]');
            var totalAmount = document.getElementById('bookingTotalAmount');
            var durationText = document.getElementById('bookingDuration');
            var rate = parseFloat('@((ViewBag.WorkerRate ?? 0m).ToString("F2"))');

            function updateEstimate() {
                if (!startInput.value || !endInput.value || rate <= 0) {
                    totalAmount.textContent = '₹0.00';
                    durationText.textContent = '';
                    return;
                }

                var start = new Date(startInput.value);
                var end = new Date(endInput.value);
                if (isNaN(start.valueOf()) || isNaN(end.valueOf()) || end <= start) {
                    totalAmount.textContent = 'Enter valid start and end times';
                    durationText.textContent = '';
                    return;
                }

                var hours = (end - start) / (1000 * 60 * 60);
                if (hours <= 0) {
                    totalAmount.textContent = 'Enter valid start and end times';
                    durationText.textContent = '';
                    return;
                }

                var total = hours * rate;
                totalAmount.textContent = '₹' + total.toFixed(2);
                durationText.textContent = hours.toFixed(2) + ' hours';
            }

            startInput.addEventListener('change', updateEstimate);
            endInput.addEventListener('change', updateEstimate);
            updateEstimate();
        })();
    </script>
}
