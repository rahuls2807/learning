@model IEnumerable<WorkerBookingSystem.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    var currentBookings = Model.Where(b => b.Status == WorkerBookingSystem.Models.BookingStatus.Pending ||
                                           b.Status == WorkerBookingSystem.Models.BookingStatus.Confirmed ||
                                           b.Status == WorkerBookingSystem.Models.BookingStatus.InProgress).ToList();
    var historyBookings = Model.Where(b => b.Status == WorkerBookingSystem.Models.BookingStatus.Completed ||
                                           b.Status == WorkerBookingSystem.Models.BookingStatus.Cancelled).ToList();
    var amountDue = Model.Sum(b => Math.Max(0, b.TotalWage - b.AmountPaidOnline - b.AmountPaidToWorker));
}

<div class="container">
    <div class="page-header">
        <div class="section-kicker">Booking hub</div>
        <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
            <div>
                <h1>My Bookings</h1>
                <p class="text-muted mb-0">Track active jobs, dues, worker contact, payment status, and history without hunting through tables.</p>
            </div>
            <a href="@Url.Action("BookWorker")" class="btn btn-primary">Book New Worker</a>
        </div>
    </div>

    @if (TempData["PaymentMessage"] != null)
    {
        <div class="alert alert-success">@TempData["PaymentMessage"]</div>
    }
    @if (TempData["BookingMessage"] != null)
    {
        <div class="alert alert-success">@TempData["BookingMessage"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Active bookings</span>
                    <span class="metric-value">@currentBookings.Count</span>
                    <span class="text-muted">Pending, confirmed, or in progress</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">Payment due</span>
                    <span class="metric-value">₹@amountDue.ToString("F2")</span>
                    <span class="text-muted">Outstanding across bookings</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card metric-card">
                <div class="card-body">
                    <span class="metric-icon">History</span>
                    <span class="metric-value">@historyBookings.Count</span>
                    <span class="text-muted">Completed or cancelled jobs</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="tabs-container">
            <button type="button" class="tab-btn active" data-tab-target="current-tab">Active (@currentBookings.Count)</button>
            <button type="button" class="tab-btn" data-tab-target="history-tab">History (@historyBookings.Count)</button>
        </div>

        <div id="current-tab" class="tab-content">
            @if (currentBookings.Any())
            {
                <div class="row g-3 booking-card-row">
                    @foreach (var booking in currentBookings)
                    {
                        var balance = booking.TotalWage - booking.AmountPaidOnline - booking.AmountPaidToWorker;
                        var statusClass = $"status-{booking.Status.ToString().ToLowerInvariant()}";

                        <div class="col-lg-6">
                            <div class="card booking-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between gap-2 align-items-start">
                                        <div>
                                            <h5 class="card-title mb-1">@booking.Worker?.FirstName @booking.Worker?.LastName</h5>
                                            <span class="text-muted">@booking.BookingDate.ToShortDateString() at @booking.StartTime.ToShortTimeString()</span>
                                        </div>
                                        <span class="status-pill @statusClass">@booking.Status</span>
                                    </div>
                                    <p class="mt-3 mb-2">@booking.TaskDescription</p>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <small class="text-muted d-block">Total</small>
                                            <strong>₹@booking.TotalWage.ToString("F2")</strong>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Due</small>
                                            <strong class="@(balance > 0 ? "money-display danger" : "money-display")">₹@Math.Max(0, balance).ToString("F2")</strong>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Online paid</small>
                                            <span>₹@booking.AmountPaidOnline.ToString("F2")</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Cash paid</small>
                                            <span>₹@booking.AmountPaidToWorker.ToString("F2")</span>
                                        </div>
                                    </div>
                                    <div class="text-muted mt-3">
                                        @booking.Worker?.Email<br />
                                        @booking.Worker?.PhoneNumber
                                    </div>
                                    @if (balance > 0)
                                    {
                                        <a asp-controller="Payment" asp-action="Pay" asp-route-bookingId="@booking.BookingId" class="btn btn-primary w-100 mt-3">Pay Balance</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <h3>No active bookings</h3>
                    <p class="text-muted">Book a worker when you need help and active jobs will appear here.</p>
                    <a href="@Url.Action("BookWorker")" class="btn btn-primary">Find Workers</a>
                </div>
            }
        </div>

        <div id="history-tab" class="tab-content" style="display:none;">
            @if (historyBookings.Any())
            {
                <div class="table-wrapper">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Worker</th>
                                <th>Date</th>
                                <th>Task</th>
                                <th>Total</th>
                                <th>Paid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in historyBookings)
                            {
                                var paid = booking.AmountPaidOnline + booking.AmountPaidToWorker;
                                var statusClass = $"status-{booking.Status.ToString().ToLowerInvariant()}";
                                <tr>
                                    <td>@booking.Worker?.FirstName @booking.Worker?.LastName</td>
                                    <td>@booking.BookingDate.ToShortDateString()</td>
                                    <td>@booking.TaskDescription</td>
                                    <td>₹@booking.TotalWage.ToString("F2")</td>
                                    <td>₹@paid.ToString("F2")</td>
                                    <td><span class="status-pill @statusClass">@booking.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <h3>No booking history</h3>
                    <p class="text-muted mb-0">Completed and cancelled bookings will appear here.</p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <h3>Start your first booking</h3>
            <p class="text-muted">Find a skilled worker, compare the profile, and book from your phone or desktop.</p>
            <a href="@Url.Action("BookWorker")" class="btn btn-primary">Find Workers</a>
        </div>
    }
</div>

<script>
    document.querySelectorAll("[data-tab-target]").forEach((button) => {
        button.addEventListener("click", () => {
            document.querySelectorAll(".tab-content").forEach((tab) => tab.style.display = "none");
            document.querySelectorAll(".tab-btn").forEach((tabButton) => tabButton.classList.remove("active"));
            document.getElementById(button.dataset.tabTarget).style.display = "block";
            button.classList.add("active");
        });
    });
</script>
