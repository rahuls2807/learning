@{
    ViewData["Title"] = "Indian Worker Mandi";
}

<section class="hero-section">
    <div class="eyebrow mb-2">Trusted local services, booked fast</div>
    <h1>Book skilled workers with clear prices, ratings, and payment tracking.</h1>
    <p class="mt-3 mb-4">
        A simpler marketplace for clients, workers, and admins: search by skill, compare profiles,
        manage jobs, and keep every booking visible from phone or desktop.
    </p>
    <div class="hero-badge-row mb-4">
        <span class="hero-badge">Verified profiles</span>
        <span class="hero-badge">Live booking status</span>
        <span class="hero-badge">UPI and cash records</span>
        <span class="hero-badge">Ratings and reviews</span>
    </div>
    <div class="quick-action-row">
        @if (!User.IsInRole("Client") && User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-primary" href="@Url.Action("Create", "Worker")">Register as Worker</a>
        }
        <a class="btn btn-primary" href="@Url.Action("BookWorker", "Client")">Find Workers</a>
        <a class="btn btn-secondary" href="@Url.Action("Register", "Client")">Register as Client</a>
        <a class="btn btn-secondary" href="@Url.Action("Install", "Mobile")">Install Phone App</a>
    </div>
</section>

<section class="market-panel mt-4">
    <div class="row g-3 align-items-center">
        <div class="col-lg-4">
            <div class="section-kicker">Marketplace ideas added</div>
            <h2 class="section-title">Built for quick decisions</h2>
            <p class="text-muted mb-lg-0">Inspired by modern food and service marketplaces: fewer steps, stronger trust signals, and thumb-friendly actions.</p>
        </div>
        <div class="col-lg-8">
            <div class="trust-row">
                <span class="trust-pill">Smart skill search</span>
                <span class="trust-pill">Top worker highlights</span>
                <span class="trust-pill">Due payment alerts</span>
                <span class="trust-pill">Mobile bottom navigation</span>
                <span class="trust-pill">Assistant help</span>
            </div>
        </div>
    </div>
</section>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="card feature-card">
            <div class="card-body">
                <div class="section-kicker">For clients</div>
                <h5 class="card-title">Find the right worker faster</h5>
                <p class="card-text text-muted">Compare rates, completed jobs, ratings, profile details, and skill matches before booking.</p>
                <a href="@Url.Action("BookWorker", "Client")" class="btn btn-primary w-100">Book a Worker</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-card">
            <div class="card-body">
                <div class="section-kicker">For workers</div>
                <h5 class="card-title">Keep jobs and earnings clear</h5>
                <p class="card-text text-muted">Manage your profile, availability, active jobs, reviews, and payment records in one place.</p>
                <a href="@Url.Action("Index", "Worker")" class="btn btn-primary w-100">View Workers</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-card">
            <div class="card-body">
                <div class="section-kicker">For admins</div>
                <h5 class="card-title">Control operations simply</h5>
                <p class="card-text text-muted">Track bookings, rates, payments, outstanding balances, top skills, and platform growth.</p>
                <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-primary w-100">Open Dashboard</a>
            </div>
        </div>
    </div>
</div>

<section class="market-panel mt-4">
    <div class="row g-3">
        <div class="col-md-3">
            <strong>1. Search</strong>
            <p class="text-muted mb-0">Filter workers by name, skill, rate, and reputation.</p>
        </div>
        <div class="col-md-3">
            <strong>2. Compare</strong>
            <p class="text-muted mb-0">Review completed jobs, ratings, and profile details.</p>
        </div>
        <div class="col-md-3">
            <strong>3. Book</strong>
            <p class="text-muted mb-0">Create bookings with clear time, task, and amount tracking.</p>
        </div>
        <div class="col-md-3">
            <strong>4. Track</strong>
            <p class="text-muted mb-0">See status, payment dues, and history from mobile too.</p>
        </div>
    </div>
</section>
