@{
    ViewData["Title"] = "Install App";
}

<div class="container mt-5 mobile-install-page">
    <div class="page-header mobile-install-hero">
        <div>
            <p class="text-uppercase text-muted mb-2">Mobile App</p>
            <h2>Install Indian Worker Mandi</h2>
            <p class="mb-0">Use the full booking system from your phone home screen on Android or iOS.</p>
        </div>
        <button id="pwaInstallButton" type="button" class="btn btn-primary mobile-install-action" hidden>
            Install App
        </button>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Android</h5>
                    <p class="card-text">Open this site in Chrome, then use Install App when it appears.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">iPhone</h5>
                    <p class="card-text">Open this site in Safari, tap Share, then Add to Home Screen.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Works Online</h5>
                    <p class="card-text">Bookings, payment, profiles, admin, worker, and client flows stay connected to the live app.</p>
                </div>
            </div>
        </div>
    </div>
</div>
