@model WorkerBookingSystem.Models.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Secure Payment";
}

<style>
    * {
        margin: 0;
        padding: 0;
    }

    :root {
        --brand: #1d4ed8;
        --brand-strong: #0f172a;
        --brand-soft: #e0ecff;
        --accent: #10b981;
        --accent-soft: #ecfdf5;
        --ink: #172033;
        --muted: #58657c;
        --line: #e5e7eb;
        --panel: #ffffff;
        --page: #f5f7fb;
        --shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        --radius: 20px;
    }

    body {
        background: linear-gradient(180deg, #f4f7fb 0%, #edf3ff 100%);
        min-height: 100vh;
        color: var(--ink);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        overflow-x: hidden;
    }

    .payment-wrapper {
        background: linear-gradient(180deg, rgba(237, 243, 255, 0.65) 0%, rgba(255, 255, 255, 0.95) 100%);
        min-height: 100vh;
        padding: 32px 20px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .payment-wrapper::before {
        content: '';
        position: fixed;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(29, 78, 216, 0.06), transparent 28%),
                    radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.08), transparent 35%);
        pointer-events: none;
    }

    .payment-container {
        position: relative;
        z-index: 1;
        max-width: 760px;
        width: 100%;
    }

    .payment-card {
        background: rgba(255, 255, 255, 0.98);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 28px;
        padding: clamp(22px, 4vw, 38px);
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }

    .payment-header {
        position: relative;
        z-index: 2;
        text-align: left;
        margin-bottom: 28px;
    }

    .payment-header h1 {
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 800;
        color: var(--brand-strong);
        margin-bottom: 8px;
        letter-spacing: -0.04em;
        text-shadow: none;
        background: none;
        -webkit-text-fill-color: var(--brand-strong);
    }

    .payment-header p {
        color: var(--muted);
        font-size: 1rem;
        opacity: 1;
    }

    .summary-box {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 24px;
        position: relative;
        z-index: 2;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 1rem;
        align-items: center;
    }

    .summary-item label {
        color: var(--muted);
        font-weight: 600;
    }

    .summary-item .value {
        color: var(--brand-strong);
        font-weight: 700;
        text-shadow: none;
    }

    .summary-item .value.danger {
        color: #d92d20;
        text-shadow: none;
    }

    .step-container {
        position: relative;
        z-index: 2;
        margin-bottom: 35px;
    }

    .step-header {
        font-size: 1.4rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #ff0055, #00ffcc);
        border-radius: 50%;
        font-weight: 800;
        color: #000;
        box-shadow: 0 0 20px rgba(255, 0, 0, 0.4);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        color: #b0b0b0;
        font-weight: 600;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
    }

    .form-control {
        background: linear-gradient(135deg, rgba(255, 0, 0, 0.05) 0%, rgba(0, 255, 200, 0.05) 100%);
        border: 2px solid rgba(0, 255, 200, 0.2);
        color: #00ffcc;
        padding: 15px;
        border-radius: 10px;
        font-size: 1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(5px);
    }

    .form-control::placeholder {
        color: rgba(0, 255, 200, 0.4);
    }

    .form-control:focus {
        outline: none;
        border-color: #ff0055;
        box-shadow: 0 0 20px rgba(255, 0, 85, 0.3), inset 0 0 10px rgba(255, 0, 85, 0.1);
        color: #00ffcc;
    }

    .form-text {
        color: #888;
        font-size: 0.9rem;
        margin-top: 8px;
        display: block;
    }

    .payment-methods {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 20px;
    }

    .payment-method-btn {
        background: linear-gradient(135deg, rgba(255, 0, 0, 0.1) 0%, rgba(0, 255, 200, 0.1) 100%);
        border: 2px solid rgba(0, 255, 200, 0.3);
        color: #e0e0e0;
        padding: 20px;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.320, 1);
        font-weight: 600;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 255, 200, 0.1);
    }

    .payment-method-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
        transition: left 0.5s;
    }

    .payment-method-btn:hover {
        transform: translateY(-5px);
        border-color: #ff0055;
        box-shadow: 0 15px 40px rgba(255, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        color: #ff0055;
    }

    .payment-method-btn:hover::before {
        left: 100%;
    }

    .payment-method-btn.active {
        background: linear-gradient(135deg, #ff0055 0%, #00ffcc 100%);
        border-color: #ff0055;
        color: #000;
        box-shadow: 0 0 30px rgba(255, 0, 85, 0.5);
    }

    .btn-pay {
        background: linear-gradient(135deg, #ff0055 0%, #00ffcc 100%);
        border: none;
        color: #000;
        font-weight: 700;
        padding: 18px 40px;
        border-radius: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 1.1rem;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 30px rgba(255, 0, 85, 0.4);
        width: 100%;
        margin-top: 20px;
    }

    .btn-pay::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.3);
        transition: left 0.3s;
    }

    .btn-pay:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px rgba(255, 0, 85, 0.6);
    }

    .btn-pay:hover::before {
        left: 100%;
    }

    .compliance-notice {
        background: linear-gradient(135deg, rgba(255, 0, 0, 0.08) 0%, rgba(0, 255, 200, 0.08) 100%);
        border: 2px solid rgba(0, 255, 200, 0.3);
        border-radius: 12px;
        padding: 20px;
        margin-top: 30px;
        position: relative;
        z-index: 2;
        font-size: 0.95rem;
        color: #b0b0b0;
        backdrop-filter: blur(5px);
    }

    .compliance-notice strong {
        color: #00ffcc;
        display: block;
        margin-bottom: 10px;
    }

    .alert-success, .alert-danger {
        border-radius: 12px;
        border: 2px solid;
        padding: 20px;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
    }

    .alert-success {
        background: rgba(0, 200, 100, 0.15);
        border-color: #00ff88;
        color: #00ff88;
    }

    .alert-danger {
        background: rgba(255, 0, 0, 0.15);
        border-color: #ff0055;
        color: #ff6b6b;
    }

    .btn-cancel {
        background: linear-gradient(135deg, rgba(100, 100, 150, 0.3) 0%, rgba(80, 80, 120, 0.3) 100%);
        border: 2px solid rgba(100, 100, 150, 0.4);
        color: #b0b0b0;
        font-weight: 600;
        padding: 12px 30px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: linear-gradient(135deg, rgba(100, 100, 150, 0.5) 0%, rgba(80, 80, 120, 0.5) 100%);
        border-color: #00ffcc;
        color: #00ffcc;
    }

    .security-badge {
        display: inline-block;
        background: rgba(0, 255, 200, 0.1);
        border: 1px solid rgba(0, 255, 200, 0.3);
        color: #00ffcc;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        margin-right: 8px;
        margin-bottom: 8px;
        font-weight: 600;
    }
</style>

<style>
    body {
        background: #f5f7fb !important;
        color: var(--ink) !important;
    }

    .payment-wrapper {
        min-height: auto !important;
        padding: 32px 20px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: linear-gradient(180deg, rgba(237, 243, 255, 0.7), rgba(255, 255, 255, 0.95)) !important;
    }

    .payment-wrapper::before,
    .payment-card::before {
        display: none !important;
    }

    .payment-container {
        max-width: 760px !important;
        margin: 0 auto !important;
    }

    .payment-card,
    .summary-box,
    .payment-option,
    .qr-container,
    .compliance-notice {
        background: #ffffff !important;
        border: 1px solid var(--line) !important;
        border-radius: var(--radius) !important;
        box-shadow: var(--shadow) !important;
        color: var(--ink) !important;
    }

    .payment-card {
        padding: clamp(20px, 4vw, 36px) !important;
    }

    .payment-header h1 {
        background: none !important;
        -webkit-text-fill-color: var(--ink) !important;
        color: var(--ink) !important;
        font-size: clamp(1.9rem, 4vw, 2.6rem) !important;
        text-shadow: none !important;
        animation: none !important;
        letter-spacing: -0.04em !important;
    }

    .payment-header p,
    .summary-item .value,
    .form-label,
    .step-header,
    .form-text,
    .payment-method-label,
    .compliance-notice {
        color: var(--muted) !important;
        text-shadow: none !important;
    }

    .summary-item .value.danger,
    .payment-amount,
    .step-number {
        color: var(--brand) !important;
        background: transparent !important;
        box-shadow: none !important;
    }

    .form-control {
        background: #ffffff !important;
        border-color: #d9dfeb !important;
        color: var(--ink) !important;
    }

    .btn-pay,
    .btn-verify,
    .btn-login {
        background: linear-gradient(135deg, #2563eb 0%, #0f172a 100%) !important;
        border-color: #2563eb !important;
        color: #ffffff !important;
        box-shadow: 0 10px 20px rgba(37, 99, 235, 0.22) !important;
    }

    .btn-cancel,
    .btn-outline-light {
        background: #ffffff !important;
        border: 1px solid #dbeafe !important;
        color: var(--brand) !important;
    }
</style>

<div class="payment-wrapper">
    <div class="payment-container">
        <div class="payment-card">
            <div class="payment-header">
                <h1>⚡ SECURE PAYMENT PORTAL</h1>
                <p>RBI-Compliant Tokenized Payment Gateway</p>
            </div>

            <!-- Payment Summary -->
            <div class="summary-box">
                <div class="summary-item">
                    <label>💰 Total Amount:</label>
                    <span class="value">₹@Model.Amount.ToString("F2")</span>
                </div>
                <div class="summary-item">
                    <label>✅ Already Paid Online:</label>
                    <span class="value">₹@Model.AlreadyPaidOnline.ToString("F2")</span>
                </div>
                <div class="summary-item">
                    <label>🔄 Paid to Worker:</label>
                    <span class="value">₹@Model.AlreadyPaidToWorker.ToString("F2")</span>
                </div>
                <div class="summary-item" style="border-top: 1px solid rgba(0, 255, 200, 0.2); padding-top: 12px;">
                    <label>⚠️ Balance Due:</label>
                    <span class="value danger">₹@Model.BalanceDue.ToString("F2")</span>
                </div>
            </div>

            <input type="hidden" id="bookingId" value="@Model.BookingId" />
            <input type="hidden" id="amount" value="@Model.OnlineAmount" />
            <input type="hidden" id="merchantUpi" value="@Model.MerchantUpiId" />
            <input type="hidden" id="upiPayUri" value="@Model.UpiPayUri" />

            <div id="devOtpBanner" class="alert alert-success" style="display:none; position:relative; z-index:2;"></div>

            <!-- Step 1: Phone Number for OTP -->
            <div id="step1-phone" class="step-container">
                <div class="step-header">
                    <span class="step-number">1</span>
                    Enter Phone Number for OTP
                </div>
                <div class="form-group">
                    <label for="phoneNumber" class="form-label">📱 Phone Number</label>
                    <input type="tel" id="phoneNumber" class="form-control" placeholder="+91 XXXXXXXXXX" value="@(Model.PhoneNumber ?? string.Empty)" />
                    <span class="form-text">OTP is sent to the client's mobile number via SMS (MSG91 or Twilio).</span>
                </div>
                <button type="button" class="btn btn-pay" id="requestOtpBtn" onclick="requestOtp()">
                    <i class="fas fa-sms"></i> Send OTP
                </button>
            </div>

            <!-- Step 2: OTP Verification -->
            <div id="step2-otp" class="step-container" style="display:none;">
                <div class="step-header">
                    <span class="step-number">2</span>
                    Verify OTP
                </div>
                <div class="form-group">
                    <label for="otpCode" class="form-label">🔐 Enter OTP Code</label>
                    <input type="text" id="otpCode" class="form-control" maxlength="6" placeholder="000000" />
                    <span class="form-text">✓ Valid for 10 minutes • Attempts remaining: <span id="otpAttempts">3</span></span>
                </div>
            </div>

            <!-- Step 3: Payment -->
            <div id="step3-payment" class="step-container" style="display:none;">
                <div class="step-header">
                    <span class="step-number">3</span>
                    Pay securely
                </div>

                @if (Model.RazorpayConfigured)
                {
                    <div id="gatewayPanel" class="summary-box">
                        <p style="margin-bottom:16px;"><strong>Receive money securely through UPI apps and cards</strong><br />Choose the method that fits the customer experience best.</p>
                        <div class="payment-methods">
                            <button type="button" class="payment-method-btn active" onclick="startGatewayUpiPayment()">
                                📱 UPI Apps (PhonePe, GPay, Paytm)
                            </button>
                            <button type="button" class="payment-method-btn" onclick="startGatewayCardPayment()">
                                💳 Cards / Net Banking / Wallet
                            </button>
                        </div>
                        <p class="form-text" style="margin-top:16px;">The gateway will collect the payment using the selected method and confirm it automatically.</p>
                    </div>
                    <p class="form-text" style="margin:16px 0; text-align:center;">— or pay manually to the merchant UPI below —</p>
                }
                else
                {
                    <div class="alert alert-success" style="position:relative; z-index:2;">
                        <strong>Automatic UPI (Zomato-style)</strong> needs Razorpay keys in configuration.
                        Until then, scan the QR below and tap confirm after paying.
                    </div>
                }

                <div id="directUpiPanel" class="summary-box">
                    <p style="margin-bottom:12px;">Manual UPI to <strong>@Model.MerchantUpiId</strong> — <strong>₹@Model.OnlineAmount.ToString("F2")</strong></p>
                    <p class="form-text" style="margin-bottom:16px;">@Model.PaymentInstructions</p>
                    <div style="text-align:center; margin-bottom:16px;">
                        <img src="@Model.UpiQrCodeUrl" alt="UPI QR code" width="260" height="260" style="border-radius:12px; background:#fff; padding:8px;" />
                    </div>
                    <p class="form-text" style="margin-bottom:16px; text-align:center;">
                        <a href="@Model.UpiPayUri" class="btn btn-sm btn-outline-light">Open in UPI app</a>
                        <button type="button" class="btn btn-sm btn-outline-light ms-2" onclick="copyMerchantUpi()">Copy UPI ID</button>
                    </p>
                    <div class="form-group">
                        <label class="form-label">Your UPI ID <span style="color:#888;">(optional)</span></label>
                        <input type="text" id="clientUpiId" class="form-control" placeholder="yourname@@ybl" value="@Model.ClientUpiId" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">UTR / transaction ID <span style="color:#888;">(optional — helps admin verify faster)</span></label>
                        <input type="text" id="upiTransactionRef" class="form-control" placeholder="From your UPI app after payment" />
                    </div>
                    <label style="display:flex; gap:10px; align-items:flex-start; margin-bottom:16px; color:#b0b0b0;">
                        <input type="checkbox" id="confirmPaidCheckbox" style="margin-top:4px;" />
                        <span>I have paid ₹@Model.OnlineAmount.ToString("F2") to @Model.MerchantUpiId</span>
                    </label>
                    <button type="button" class="btn btn-pay" onclick="submitDirectUpiPayment()">
                        ✓ Confirm payment — submit for admin verification
                    </button>
                </div>

                <div class="summary-box" style="margin-top:24px;">
                    <div class="step-header" style="margin-bottom:16px;">
                        <span class="step-number">4</span>
                        Send payout to worker
                    </div>
                    <p class="form-text" style="margin-bottom:16px;">Record a payout to the worker using UPI, card, or wallet details and keep the booking balance accurate.</p>
                    <div class="form-group">
                        <label class="form-label">Payout method</label>
                        <select id="payoutMethod" class="form-control">
                            <option value="UPI">UPI</option>
                            <option value="Card">Card</option>
                            <option value="Wallet">Wallet</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Recipient reference</label>
                        <input type="text" id="payoutRecipient" class="form-control" placeholder="Worker UPI ID / wallet reference" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Amount to send</label>
                        <input type="number" id="payoutAmount" class="form-control" step="0.01" min="0" max="@Model.MaxPayoutAmount" value="@Model.MaxPayoutAmount" />
                    </div>
                    <button type="button" class="btn btn-pay" onclick="submitPayout()">
                        🚀 Send money to worker
                    </button>
                </div>
            </div>

            <!-- Messages -->
            <div id="successMessage" class="alert alert-success" style="display:none;"></div>
            <div id="errorMessage" class="alert alert-danger" style="display:none;"></div>

            <!-- Cancel Button -->
            <a asp-controller="Client" asp-action="MyBookings" class="btn btn-cancel">← Back to Bookings</a>

            <!-- Compliance Notice -->
            <div class="compliance-notice">
                <strong>🇮🇳 RBI Compliance Certified</strong>
                This payment gateway fully complies with RBI Payment Systems Regulations 2008 (amended 2021). All card data is tokenized and never stored on our servers. 2FA via OTP is mandatory for all transactions.
            </div>
        </div>
    </div>
</div>

<!-- Razorpay Checkout Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    const bookingId = document.getElementById('bookingId').value;
    const amount = parseFloat(document.getElementById('amount').value);
    const razorpayEnabled = @(Model.RazorpayConfigured ? "true" : "false");
    let razorpayOrderId = '';
    let gatewayPaymentMethod = 'upi';

    function copyMerchantUpi() {
        const vpa = document.getElementById('merchantUpi').value;
        navigator.clipboard.writeText(vpa).then(() => showSuccess('UPI ID copied: ' + vpa));
    }

    function requestOtp() {
        const phoneNumber = document.getElementById('phoneNumber').value.trim();
        if (phoneNumber.replace(/\D/g, '').length < 10) {
            showError('Enter the client mobile number (10 digits, +91)');
            return;
        }

        fetch('/Payment/RequestOtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookingId: parseInt(bookingId, 10), phoneNumber: phoneNumber })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                if (data.devMode && data.devOtp) {
                    const banner = document.getElementById('devOtpBanner');
                    banner.style.display = 'block';
                    banner.innerHTML = '<strong>SMS provider not configured.</strong> Dev OTP: <span style="font-size:1.4rem; letter-spacing:4px;">' + data.devOtp + '</span>';
                }
                showSuccess(data.devMode ? data.message : ('OTP sent by SMS to ' + phoneNumber));
                document.getElementById('step1-phone').style.display = 'none';
                document.getElementById('step2-otp').style.display = 'block';
            } else {
                showError(data.message || 'Failed to send OTP');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    function proceedAfterOtpVerified(message) {
        document.getElementById('step2-otp').style.display = 'none';
        document.getElementById('step3-payment').style.display = 'block';
        showSuccess(message);
        if (razorpayEnabled) {
            setTimeout(() => startGatewayUpiPayment(), 400);
        }
    }

    function verifyOtpForPaymentStep() {
        const otpCode = document.getElementById('otpCode').value.trim();
        if (!otpCode || otpCode.length !== 6) {
            showError('Please enter a valid 6-digit OTP');
            return;
        }

        fetch('/Payment/VerifyOtpOnly', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookingId: parseInt(bookingId, 10), otpCode: otpCode })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                proceedAfterOtpVerified(razorpayEnabled
                    ? 'OTP verified. Opening UPI payment...'
                    : 'OTP verified. Pay via QR, then confirm below.');
            } else {
                showError(data.message || 'Invalid OTP');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    function submitDirectUpiPayment() {
        const otpCode = document.getElementById('otpCode').value.trim();
        const clientUpiId = document.getElementById('clientUpiId').value.trim();
        const transactionRef = document.getElementById('upiTransactionRef').value.trim();
        const confirmed = document.getElementById('confirmPaidCheckbox').checked;

        if (!otpCode || otpCode.length !== 6) {
            showError('Complete OTP verification first');
            return;
        }
        if (!confirmed) {
            showError('Please tick the box to confirm you paid to ' + document.getElementById('merchantUpi').value);
            return;
        }

        fetch('/Payment/SubmitUpiPayment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookingId: parseInt(bookingId, 10),
                amount: amount,
                otpCode: otpCode,
                clientUpiId: clientUpiId || null,
                transactionReference: transactionRef || null
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showSuccess('✅ ' + data.message);
                setTimeout(() => window.location.href = '/Client/MyBookings', 2500);
            } else {
                showError(data.message || 'Could not submit payment');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    function submitPayout() {
        const otpCode = document.getElementById('otpCode').value.trim();
        const payoutMethod = document.getElementById('payoutMethod').value;
        const payoutRecipient = document.getElementById('payoutRecipient').value.trim();
        const payoutAmount = parseFloat(document.getElementById('payoutAmount').value || '0');

        if (!otpCode || otpCode.length !== 6) {
            showError('Complete OTP verification first');
            return;
        }

        if (!payoutRecipient) {
            showError('Add a worker payout reference before sending money');
            return;
        }

        if (!payoutAmount || payoutAmount <= 0) {
            showError('Enter a valid payout amount');
            return;
        }

        fetch('/Payment/SubmitPayout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookingId: parseInt(bookingId, 10),
                amount: payoutAmount,
                otpCode: otpCode,
                payoutMethod: payoutMethod,
                recipientIdentifier: payoutRecipient,
                notes: 'Worker payout'
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showSuccess('✅ ' + data.message);
                setTimeout(() => window.location.reload(), 1800);
            } else {
                showError(data.message || 'Could not send payout');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    function startGatewayUpiPayment() {
        gatewayPaymentMethod = 'upi';
        document.querySelectorAll('.payment-method-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelector('.payment-method-btn').classList.add('active');
        openRazorpayCheckout();
    }

    function startGatewayCardPayment() {
        gatewayPaymentMethod = 'card';
        document.querySelectorAll('.payment-method-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.payment-method-btn')[1].classList.add('active');
        openRazorpayCheckout();
    }

    function openRazorpayCheckout() {
        const otpCode = document.getElementById('otpCode').value.trim();
        if (!otpCode || otpCode.length !== 6) {
            showError('Enter your 6-digit OTP first');
            return;
        }

        const launchCheckout = () => {
            if (gatewayPaymentMethod === 'upi') {
                initiateUPIPayment();
            } else {
                initiateCardPayment();
            }
        };

        if (razorpayOrderId) {
            launchCheckout();
            return;
        }

        fetch('/Payment/CreateOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookingId: parseInt(bookingId, 10), amount: amount, otpCode: otpCode })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                razorpayOrderId = data.orderId;
                launchCheckout();
            } else {
                showError(data.message || 'Could not start payment. Check Razorpay configuration.');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    // Card/Net Banking Payment
    function initiateCardPayment() {
        const options = {
            key: '@Model.RazorpayKeyId',
            amount: Math.round(amount * 100),
            currency: 'INR',
            name: '⚡ Indian Worker Mandi',
            description: 'Payment for Booking #' + bookingId,
            order_id: razorpayOrderId,
            handler: function(response) {
                verifyPayment(response.razorpay_payment_id, response.razorpay_signature);
            },
            prefill: {
                name: '@User.Identity?.Name',
                contact: '@Model.PhoneNumber'
            },
            theme: {
                color: '#e23744'
            },
            modal: {
                ondismiss: function() {
                    showError('Payment cancelled');
                }
            }
        };

        const rzp = new Razorpay(options);
        rzp.open();
    }

    function initiateUPIPayment() {
        const options = {
            key: '@Model.RazorpayKeyId',
            amount: Math.round(amount * 100),
            currency: 'INR',
            name: 'Indian Worker Mandi',
            description: 'Booking #' + bookingId,
            order_id: razorpayOrderId,
            handler: function(response) {
                verifyPayment(response.razorpay_payment_id, response.razorpay_signature);
            },
            prefill: {
                name: '@User.Identity?.Name',
                contact: '@Model.PhoneNumber'
            },
            theme: { color: '#e23744' },
            modal: { ondismiss: function() { showError('Payment cancelled'); } },
            config: {
                display: {
                    blocks: {
                        upi: {
                            name: 'Pay with UPI apps',
                            instruments: [{ method: 'upi' }]
                        }
                    },
                    sequence: ['block.upi'],
                    preferences: { show_default_blocks: false }
                }
            }
        };

        new Razorpay(options).open();
    }

    // Server-side Verification
    function verifyPayment(paymentId, signature) {
        const otpCode = document.getElementById('otpCode').value;

        fetch('/Payment/VerifyPayment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookingId: bookingId,
                razorpayOrderId: razorpayOrderId,
                razorpayPaymentId: paymentId,
                razorpaySignature: signature,
                otpCode: otpCode
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showSuccess('✅ Payment completed successfully!');
                setTimeout(() => window.location.href = '/Client/MyBookings', 2000);
            } else {
                showError(data.message || 'Payment verification failed');
                document.getElementById('step3-payment').style.display = 'none';
                document.getElementById('step2-otp').style.display = 'block';
            }
        })
        .catch(e => {
            showError('Error: ' + e.message);
            document.getElementById('step3-payment').style.display = 'none';
            document.getElementById('step2-otp').style.display = 'block';
        });
    }

    function showSuccess(msg) {
        const el = document.getElementById('successMessage');
        el.textContent = msg;
        el.style.display = 'block';
        document.getElementById('errorMessage').style.display = 'none';
    }

    function showError(msg) {
        const el = document.getElementById('errorMessage');
        el.textContent = '❌ ' + msg;
        el.style.display = 'block';
        document.getElementById('successMessage').style.display = 'none';
    }

    document.getElementById('otpCode')?.addEventListener('input', function() {
        if (this.value.length === 6) {
            verifyOtpForPaymentStep();
        }
    });
</script>
