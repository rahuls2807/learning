@model WorkerBookingSystem.Models.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "RBI-Compliant Secure Payment";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">🔒 Secure Payment (RBI Compliant)</h4>
                </div>
                <div class="card-body">
                    <!-- Payment Summary -->
                    <div class="alert alert-info">
                        <strong>Total Amount:</strong> ₹@Model.Amount.ToString("F2")<br />
                        <strong>Already Paid Online:</strong> ₹@Model.AlreadyPaidOnline.ToString("F2") |
                        <strong>Paid to Worker:</strong> ₹@Model.AlreadyPaidToWorker.ToString("F2")<br />
                        <strong class="text-danger">Balance Due:</strong> ₹@Model.BalanceDue.ToString("F2")
                    </div>

                    <!-- Step 1: Phone Number for OTP -->
                    <div id="step1-phone" class="mb-4">
                        <h5>Step 1: Enter Phone Number for OTP</h5>
                        <div class="form-group">
                            <label for="phoneNumber" class="form-label">Phone Number (with country code)</label>
                            <input type="tel" id="phoneNumber" class="form-control" placeholder="+91..." value="+91" />
                            <small class="text-muted">Your OTP will be sent to this number</small>
                        </div>
                        <button type="button" class="btn btn-primary" id="requestOtpBtn" onclick="requestOtp()">
                            <i class="fas fa-sms"></i> Send OTP
                        </button>
                    </div>

                    <!-- Step 2: OTP Verification -->
                    <div id="step2-otp" class="mb-4" style="display:none;">
                        <h5>Step 2: Enter OTP</h5>
                        <div class="form-group">
                            <label for="otpCode" class="form-label">OTP Code (6 digits)</label>
                            <input type="text" id="otpCode" class="form-control" maxlength="6" placeholder="000000" />
                            <small class="text-muted">Valid for 10 minutes. Attempts remaining: <span id="otpAttempts">3</span></small>
                        </div>
                    </div>

                    <!-- Step 3: Razorpay Payment -->
                    <div id="step3-payment" class="mb-4" style="display:none;">
                        <h5>Step 3: Choose Payment Method</h5>
                        <input type="hidden" id="bookingId" value="@Model.BookingId" />
                        <input type="hidden" id="amount" value="@Model.OnlineAmount" />
                        <button type="button" class="btn btn-success btn-lg w-100" id="paymentBtn" onclick="initiatePayment()">
                            <i class="fas fa-lock"></i> Pay ₹@Model.OnlineAmount.ToString("F2") with Razorpay
                        </button>
                        <small class="d-block mt-2 text-muted">
                            ✓ Your card details are NOT stored<br />
                            ✓ Tokenized payment (PCI-DSS Compliant)<br />
                            ✓ Secured by Razorpay (NPCI certified)
                        </small>
                    </div>

                    <!-- Messages -->
                    <div id="successMessage" class="alert alert-success" style="display:none;"></div>
                    <div id="errorMessage" class="alert alert-danger" style="display:none;"></div>

                    <!-- Back Button -->
                    <div class="mt-4">
                        <a asp-controller="Client" asp-action="MyBookings" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>

            <!-- Compliance Notice -->
            <div class="alert alert-info mt-4 small">
                <strong>🇮🇳 RBI Compliance Notice:</strong> This payment gateway complies with RBI Payment Systems Regulations 2008 (amended 2021). 
                Payments are tokenized and card data is never stored on our servers. 2FA via OTP is mandatory for all card transactions.
            </div>
        </div>
    </div>
</div>

<!-- Razorpay Checkout Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    const bookingId = document.getElementById('bookingId').value;
    const amount = parseFloat(document.getElementById('amount').value);
    let razorpayOrderId = '';
    let otpVerified = false;

    // Step 1: Request OTP
    function requestOtp() {
        const phoneNumber = document.getElementById('phoneNumber').value.trim();
        
        if (!phoneNumber || phoneNumber.length < 10) {
            showError('Please enter a valid phone number');
            return;
        }

        fetch('/Payment/RequestOtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookingId: bookingId, phoneNumber: phoneNumber })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showSuccess('OTP sent successfully to ' + phoneNumber);
                document.getElementById('step1-phone').style.display = 'none';
                document.getElementById('step2-otp').style.display = 'block';
            } else {
                showError(data.message || 'Failed to send OTP');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    // Step 2: Verify OTP and Create Order
    function verifyOtpAndCreateOrder() {
        const otpCode = document.getElementById('otpCode').value.trim();
        
        if (!otpCode || otpCode.length !== 6) {
            showError('Please enter a valid 6-digit OTP');
            return false;
        }

        // Create Razorpay Order
        fetch('/Payment/CreateOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ bookingId: bookingId, amount: amount })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                razorpayOrderId = data.orderId;
                otpVerified = true;
                document.getElementById('step2-otp').style.display = 'none';
                document.getElementById('step3-payment').style.display = 'block';
                showSuccess('OTP verified! Now choose your payment method');
            } else {
                showError(data.message || 'Failed to create order');
            }
        })
        .catch(e => showError('Error: ' + e.message));
    }

    // Step 3: Initiate Razorpay Payment
    function initiatePayment() {
        if (!razorpayOrderId) {
            // Verify OTP first if not done
            verifyOtpAndCreateOrder();
            return;
        }

        const options = {
            key: '@Model.RazorpayKeyId',
            amount: Math.round(amount * 100),
            currency: 'INR',
            name: 'WorkerBookingSystem',
            description: 'Payment for Booking #' + bookingId,
            order_id: razorpayOrderId,
            handler: function(response) {
                // Payment successful - verify on server
                verifyPayment(response.razorpay_payment_id, response.razorpay_signature);
            },
            prefill: {
                name: '@User.Identity?.Name'
            },
            theme: {
                color: '#0d6efd'
            },
            modal: {
                ondismiss: function() {
                    showError('Payment cancelled');
                }
            }
        };

        const rzp = new Razorpay(options);
        rzp.open();
    }

    // Step 4: Server-side Verification
    function verifyPayment(paymentId, signature) {
        const otpCode = document.getElementById('otpCode').value;

        fetch('/Payment/VerifyPayment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bookingId: bookingId,
                razorpayOrderId: razorpayOrderId,
                razorpayPaymentId: paymentId,
                razorpaySignature: signature,
                otpCode: otpCode
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showSuccess('✓ Payment completed successfully!');
                setTimeout(() => window.location.href = '/Client/MyBookings', 2000);
            } else {
                showError(data.message || 'Payment verification failed');
                document.getElementById('step3-payment').style.display = 'none';
                document.getElementById('step2-otp').style.display = 'block';
            }
        })
        .catch(e => {
            showError('Error: ' + e.message);
            document.getElementById('step3-payment').style.display = 'none';
            document.getElementById('step2-otp').style.display = 'block';
        });
    }

    function showSuccess(msg) {
        const el = document.getElementById('successMessage');
        el.textContent = msg;
        el.style.display = 'block';
        document.getElementById('errorMessage').style.display = 'none';
    }

    function showError(msg) {
        const el = document.getElementById('errorMessage');
        el.textContent = '❌ ' + msg;
        el.style.display = 'block';
        document.getElementById('successMessage').style.display = 'none';
    }

    // Auto-verify OTP when all 6 digits entered
    document.getElementById('otpCode').addEventListener('input', function() {
        if (this.value.length === 6) {
            verifyOtpAndCreateOrder();
        }
    });
</script>

