<!DOCTYPE html>
@{
    var currentLanguage = WorkerBookingSystem.Services.UiLanguageCatalog.GetCurrent(System.Globalization.CultureInfo.CurrentUICulture);
    var hindiUi = currentLanguage.Culture.StartsWith("hi", StringComparison.OrdinalIgnoreCase);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var workerProfileActive = currentController == "Worker" && currentAction is "Index" or "Details" or "Edit";
    var workerJobsActive = currentController == "Worker" && currentAction == "MyBookings";
    var messageActive = currentController is "Chat" or "CommunityChat";
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name?.Split('@')[0] ?? "Account";
}
<html lang="@currentLanguage.Culture[..2]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Indian Worker Mandi</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/images/app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/images/app-icon.svg" />
    <meta name="theme-color" content="#087b70" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Indian Worker Mandi" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkerBookingSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="brand-mark" src="~/images/app-icon.svg" alt="" />
                    <span>Indian Worker Mandi</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@(hindiUi ? "घर" : "Home")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Community" asp-action="Index">@(hindiUi ? "समुदाय" : "Community")</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                            <a class="nav-link @(messageActive ? "active" : "")" aria-current="@(messageActive ? "page" : null)" asp-controller="CommunityChat" asp-action="Index">@(hindiUi ? "संदेश" : "Messages")</a>
                            </li>
                        }
                        @if (User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Client" asp-action="MyBookings">@(hindiUi ? "बुकिंग" : "Bookings")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Client" asp-action="BookWorker">@(hindiUi ? "कामगार खोजें" : "Find Workers")</a>
                            </li>
                        }
                        @if (User.IsInRole("Worker"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(workerJobsActive ? "active" : "")" aria-current="@(workerJobsActive ? "page" : null)" asp-controller="Worker" asp-action="MyBookings">@(hindiUi ? "काम" : "Jobs")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(workerProfileActive ? "active" : "")" aria-current="@(workerProfileActive ? "page" : null)" asp-controller="Worker" asp-action="Index">@(hindiUi ? "प्रोफ़ाइल" : "Profile")</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">@(hindiUi ? "डैशबोर्ड" : "Dashboard")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-booking-cta" asp-controller="Admin" asp-action="CreateBooking">Create Booking</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="MyBookings">Bookings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="ManageRates">Rates</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Mobile" asp-action="Install">Install App</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="SetLanguage" method="post" class="nav-language-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <label class="visually-hidden" for="uiLanguage">Language</label>
                                <select id="uiLanguage" name="culture" class="form-select form-select-sm" aria-label="Language" onchange="this.form.submit()">
                                    @foreach (var language in WorkerBookingSystem.Services.UiLanguageCatalog.All)
                                    {
                                        <option value="@language.Culture" selected="@(language.Culture == currentLanguage.Culture)">@language.NativeName</option>
                                    }
                                </select>
                            </form>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle nav-user text-truncate" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@displayName">@displayName</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Support" asp-action="Index">Support</a></li>
                                    <li><a class="dropdown-item" asp-controller="Wallet" asp-action="Index">Wallet</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                            <button type="submit" class="nav-logout w-100">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Create account</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <div class="text-center py-2">
                <p style="margin: 0;">© 2026 - Indian Worker Mandi | 
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a> | 
                Built for fast, trusted worker bookings</p>
            </div>
        </div>
    </footer>

    <nav class="mobile-bottom-nav" aria-label="Mobile quick navigation">
        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="Community" asp-action="Index">Community</a>
        @if (User.IsInRole("Client"))
        {
            <a asp-controller="Client" asp-action="BookWorker">Find</a>
            <a asp-controller="Client" asp-action="MyBookings">Bookings</a>
        }
        else if (User.IsInRole("Worker"))
        {
            <a class="@(workerJobsActive ? "active" : "")" aria-current="@(workerJobsActive ? "page" : null)" asp-controller="Worker" asp-action="MyBookings">Jobs</a>
            <a class="@(workerProfileActive ? "active" : "")" aria-current="@(workerProfileActive ? "page" : null)" asp-controller="Worker" asp-action="Index">Profile</a>
        }
        else if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Dashboard">Admin</a>
        }
        else
        {
            <a asp-controller="Client" asp-action="Register">Find</a>
            <a asp-controller="Account" asp-action="Login">Login</a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="@(messageActive ? "active" : "")" aria-current="@(messageActive ? "page" : null)" asp-controller="CommunityChat" asp-action="Index">Messages</a>
        }
    </nav>

    <div class="app-assistant" id="appAssistant">
        @Html.AntiForgeryToken()
        <button class="assistant-toggle" id="assistantToggle" type="button" aria-label="Open app assistant">Help</button>
        <section class="assistant-panel" id="assistantPanel" aria-live="polite" aria-label="Worker Booking assistant">
            <div class="assistant-header">
                <div>
                    <strong>Booking Assistant</strong>
                    <span>Ask about bookings, payments, jobs, or admin tasks.</span>
                </div>
                <button type="button" id="assistantClose" aria-label="Close assistant">×</button>
            </div>
            <div class="assistant-messages" id="assistantMessages">
                <div class="assistant-message assistant-message-bot">
                    Hi, I can guide you through this app. Try asking "How do I book a worker?" or "How do I record cash paid?"
                </div>
            </div>
            <form class="assistant-form" id="assistantForm">
                <input id="assistantInput" maxlength="1000" autocomplete="off" placeholder="Ask for help..." />
                <button type="submit">Send</button>
            </form>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
