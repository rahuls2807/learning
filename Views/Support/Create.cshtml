@model WorkerBookingSystem.Models.ViewModels.CreateSupportTicketViewModel
@using WorkerBookingSystem.Models
@{
    ViewData["Title"] = "Raise a support ticket";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="market-panel">
                <div class="section-kicker">Help desk</div>
                <h1 class="section-title">Raise a support ticket</h1>
                <p class="text-muted">Tell us what happened. Do not include passwords, OTP codes, or full payment credentials.</p>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">Subject</label>
                        <input asp-for="Subject" class="form-control" maxlength="120" required />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label">Category</label>
                            <select asp-for="Category" asp-items="Html.GetEnumSelectList<SupportTicketCategory>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BookingId" class="form-label">Related booking (optional)</label>
                            <select asp-for="BookingId" asp-items="Model.Bookings" class="form-select">
                                <option value="">General issue</option>
                            </select>
                            <span asp-validation-for="BookingId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mt-3 mb-3">
                        <label asp-for="Message" class="form-label">Describe the issue</label>
                        <textarea asp-for="Message" class="form-control" rows="6" maxlength="4000" required></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Submit ticket</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
