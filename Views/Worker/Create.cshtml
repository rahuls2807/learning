@model WorkerBookingSystem.Models.ViewModels.WorkerRegisterViewModel

@{
    ViewData["Title"] = "Register as Worker";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2>Worker Registration</h2>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber" class="control-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Skill" class="control-label"></label>
                    <input asp-for="Skill" class="form-control" placeholder="e.g., Plumbing, Electrical, Carpentry" />
                    <span asp-validation-for="Skill" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ProfileImage" class="control-label"></label>
                    <input asp-for="ProfileImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="ProfileImage" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Resume" class="control-label"></label>
                    <input asp-for="Resume" class="form-control" type="file" accept=".pdf,.doc,.docx" />
                    <span asp-validation-for="Resume" class="text-danger"></span>
                </div>

                <section class="market-panel mt-3">
                    <div class="section-kicker">Payout details</div>
                    <h3 class="section-title">Where should admin send your pay?</h3>

                    <div class="form-group">
                        <label asp-for="PreferredPayoutMethod" class="control-label"></label>
                        <select asp-for="PreferredPayoutMethod" class="form-select">
                            <option value="UPI">UPI</option>
                            <option value="BANK">Direct to Bank</option>
                            <option value="WALLET">Wallet</option>
                        </select>
                        <span asp-validation-for="PreferredPayoutMethod" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="UpiId" class="control-label"></label>
                        <input asp-for="UpiId" class="form-control" placeholder="worker@bank" />
                        <span asp-validation-for="UpiId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="BankAccountHolderName" class="control-label"></label>
                        <input asp-for="BankAccountHolderName" class="form-control" />
                        <span asp-validation-for="BankAccountHolderName" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BankName" class="control-label"></label>
                            <input asp-for="BankName" class="form-control" />
                            <span asp-validation-for="BankName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IfscCode" class="control-label"></label>
                            <input asp-for="IfscCode" class="form-control" />
                            <span asp-validation-for="IfscCode" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="BankAccountNumber" class="control-label"></label>
                        <input asp-for="BankAccountNumber" class="form-control" />
                        <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                    </div>
                </section>

                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="control-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">Register</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
